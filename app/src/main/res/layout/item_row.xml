<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rowCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface" app:strokeColor="@color/outline" app:strokeWidth="1dp">
