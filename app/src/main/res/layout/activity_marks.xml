<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FA"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/PortalToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F7FA"
            android:stateListAnimator="@null"
            app:elevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                app:layout_scrollFlags="scroll|enterAlways"
                android:gravity="center_horizontal">
                <TextView
                    style="@style/PortalEyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/academic_semester"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/PortalCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#EDF2FF"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="0dp"
                            android:gravity="center_horizontal">
                            <TextView
                                android:id="@+id/summary"
                                style="@style/PortalTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_marks_summary"
                                android:textSize="27sp"
                                android:textColor="#3867D6"
                                android:gravity="center"
                                android:textAlignment="center" />
                            <TextView
                                style="@style/PortalSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_cgpa_label"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:textAlignment="center" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:gravity="center_horizontal">
                            <TextView
                                style="@style/PortalTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_sgpa_value"
                                android:textSize="27sp"
                                android:textColor="#3867D6"
                                android:gravity="center"
                                android:textAlignment="center" />
                            <TextView
                                style="@style/PortalSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_sgpa_label"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:textAlignment="center" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:gravity="center_horizontal">
                            <TextView
                                style="@style/PortalTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_earned_value"
                                android:textSize="27sp"
                                android:textColor="#3867D6"
                                android:gravity="center"
                                android:textAlignment="center" />
                            <TextView
                                style="@style/PortalSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_earned_label"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:textAlignment="center" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/PortalSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/academic_marks_hint"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
