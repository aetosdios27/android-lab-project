<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_teal"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_university"
                app:tint="@color/accent"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalTitle"
                    android:text="@string/design_brand"
                    android:textSize="23sp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalEyebrow"
                    android:text="@string/design_brand_caption"
                    android:textSize="11sp"
                    android:letterSpacing="0.18"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalEyebrow"
            android:text="@string/design_greeting_eyebrow"
            android:textColor="@color/accent"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalDisplay"
            android:text="@string/design_hello"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:textAlignment="center" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/art_orbit"
                android:importantForAccessibility="no"
                android:alpha="0.7" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">
                <TextView
                    style="@style/PortalEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/design_semester"
                    android:textColor="#C2E9E5"
                    android:background="@drawable/bg_hero_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalTitle"
                    android:text="@string/program"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="4dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalSubtitle"
                    android:text="@string/design_session"
                    android:textSize="12sp"
                    android:textColor="#BBD2DF"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#355468"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalEyebrow"
                    android:text="@string/design_id_label"
                    android:textSize="11sp"
                    android:textColor="#A4BDC9"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalBody"
                    android:text="@string/design_id"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.13"
                    android:textColor="@color/white"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:id="@+id/summaryRow">
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_attendance_label"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/design_attendance_value"
                        android:textSize="28sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_attendance_caption"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_cgpa_label"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/design_cgpa_value"
                        android:textSize="28sp"
                        android:textColor="@color/blue"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_cgpa_caption"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="0dp"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_credits_label"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/design_credits_value"
                        android:textSize="23sp"
                        android:textColor="@color/gold"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_credits_caption"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalTitle"
            android:text="@string/design_workspace"
            android:textSize="24sp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalSubtitle"
            android:text="@string/design_workspace_caption"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:textAlignment="center" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:id="@+id/moduleRowOne">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attendanceButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_teal"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_attendance"
                            app:tint="@color/accent"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/attendance"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_attendance_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/marksButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_blue"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_marks"
                            app:tint="@color/blue"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/marks"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_marks_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:id="@+id/moduleRowTwo">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/timetableButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_amber"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_timetable"
                            app:tint="@color/gold"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/timetable"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_timetable_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/coursesButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_blue"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_courses"
                            app:tint="@color/blue"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/courses"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_courses_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:id="@+id/moduleRowThree">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noticesButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_amber"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_notices"
                            app:tint="@color/gold"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/notices"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_notices_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serviceRequestButton"
                style="@style/PortalCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_teal"
                            android:padding="11dp"
                            app:srcCompat="@drawable/ic_service_request"
                            app:tint="@color/accent"
                            android:importantForAccessibility="no" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            app:tint="@color/muted"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/service_request"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_service_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileButton"
            style="@style/PortalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="@string/design_initials"
                    android:textColor="@color/accent"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="16sp"
                    android:importantForAccessibility="no"
                    android:textAlignment="center"
                    android:minHeight="48dp"
                    android:minWidth="48dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalTitle"
                        android:text="@string/profile"
                        android:textSize="17sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/PortalSubtitle"
                        android:text="@string/design_profile_sub"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_arrow_right"
                    app:tint="@color/muted"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalTitle"
            android:text="@string/design_today"
            android:textSize="24sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:textAlignment="center" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/upcomingCard"
            style="@style/PortalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tealTint"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalEyebrow"
                    android:text="@string/design_class_label"
                    android:textColor="@color/accent"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalTitle"
                    android:text="@string/upcoming_class"
                    android:textSize="22sp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalBody"
                    android:text="@string/design_class_time"
                    android:textColor="@color/accent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalSubtitle"
                    android:text="@string/design_class_room"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noticeCard"
            style="@style/PortalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalEyebrow"
                    android:text="@string/design_notice_date"
                    android:textColor="@color/gold"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalTitle"
                    android:text="@string/notice_headline"
                    android:textSize="20sp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/PortalBody"
                    android:text="@string/design_notice_action"
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="8dp"
                    app:drawableEndCompat="@drawable/ic_arrow_right"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PortalSubtitle"
            android:text="@string/design_offline"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:textAlignment="center" />
    </LinearLayout>
</ScrollView>
