<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F4F7FA"
    android:gravity="center_horizontal">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/PortalToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#112D43"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">
                    <TextView
                        style="@style/PortalEyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forms_identity_eyebrow"
                        android:textColor="#B5C9D8"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="68dp"
                        android:minHeight="68dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/form_avatar_surface"
                        android:gravity="center"
                        android:padding="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:text="@string/forms_avatar_initials"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_student_name"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/forms_student_id"
                        android:textColor="#C2D3DE"
                        android:textIsSelectable="true"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/forms_verified_student"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_check"
                        android:drawableTint="#087F8C"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">
                    <TextView
                        style="@style/PortalEyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_academic_eyebrow"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="7dp"
                        android:text="@string/forms_academic_info"
                        android:textSize="17sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="#DFE7EE" />
                    <TextView
                        style="@style/PortalSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forms_university_email_label"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/forms_university_email"
                        android:textColor="#087F8C"
                        android:textIsSelectable="true"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/PortalEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/forms_personal_eyebrow"
                android:gravity="center"
                android:textAlignment="center" />
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_contact_title"
                        android:textColor="#112D43"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="20dp"
                        android:text="@string/forms_contact_caption"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <edu.muj.studentportal.ui.CenteredTextInputLayout
                        android:id="@+id/phoneLayout"
                        style="@style/PortalField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/forms_phone"
                        android:textAlignment="center">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="phone"
                            android:imeOptions="actionNext"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:singleLine="false"
                            android:scrollHorizontally="false" />
                    </edu.muj.studentportal.ui.CenteredTextInputLayout>
                    <edu.muj.studentportal.ui.CenteredTextInputLayout
                        android:id="@+id/alternateEmailLayout"
                        style="@style/PortalField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/forms_alternate_email"
                        app:helperText="@string/forms_email_helper"
                        android:textAlignment="center">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/alternateEmailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionDone"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:singleLine="false"
                            android:scrollHorizontally="false" />
                    </edu.muj.studentportal.ui.CenteredTextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveProfileButton"
                        style="@style/PortalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/forms_save_profile"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/forms_logout"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textSize="16sp"
                android:textColor="#B34B35"
                app:cornerRadius="16dp"
                app:strokeColor="#D8DDE2"
                android:gravity="center"
                android:textAlignment="center" />
            <TextView
                style="@style/PortalSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/forms_logout_note"
                android:textSize="12sp"
                android:textAlignment="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
