<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/PortalCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">
        <TextView
            android:id="@+id/eyebrow"
            style="@style/PortalEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A96732"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:id="@+id/status"
            style="@style/PortalSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:id="@+id/title"
            style="@style/PortalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAlignment="center" />
        <TextView
            android:id="@+id/detail"
            style="@style/PortalSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:textAlignment="center" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#DFE7EE"
            android:importantForAccessibility="no" />
        <TextView
            style="@style/PortalBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/academic_read_notice"
            android:textColor="#087F8C"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawableTint="#087F8C"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
