<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F4F7FA"
    android:gravity="center_horizontal">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/PortalToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_teal"
                android:padding="14dp"
                android:src="@drawable/ic_service_request"
                android:importantForAccessibility="no"
                app:tint="#087F8C" />
            <TextView
                style="@style/PortalEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/forms_support_eyebrow"
                android:gravity="center"
                android:textAlignment="center" />
            <TextView
                style="@style/PortalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/forms_request_intro"
                android:gravity="center"
                android:textAlignment="center" />
            <TextView
                style="@style/PortalSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/forms_request_caption"
                android:gravity="center"
                android:textAlignment="center" />
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">
                    <TextView
                        style="@style/PortalEyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_details_step"
                        android:textColor="#087F8C"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:labelFor="@id/requestType"
                        android:text="@string/forms_request_type"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/form_spinner_surface"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <Spinner
                            android:id="@+id/requestType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:spinnerMode="dropdown" />
                    </FrameLayout>
                    <edu.muj.studentportal.ui.CenteredTextInputLayout
                        android:id="@+id/subjectLayout"
                        style="@style/PortalField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/forms_subject"
                        android:textAlignment="center">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/subjectInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:textSize="15sp"
                            android:inputType="textCapSentences"
                            android:imeOptions="actionNext"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:singleLine="false"
                            android:scrollHorizontally="false" />
                    </edu.muj.studentportal.ui.CenteredTextInputLayout>
                    <edu.muj.studentportal.ui.CenteredTextInputLayout
                        android:id="@+id/descriptionLayout"
                        style="@style/PortalField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/forms_description"
                        app:helperText="@string/forms_description_helper"
                        android:textAlignment="center">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/descriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="textMultiLine|textCapSentences"
                            android:textSize="15sp"
                            android:minLines="4"
                            android:textAlignment="center"
                            android:singleLine="false"
                            android:scrollHorizontally="false" />
                    </edu.muj.studentportal.ui.CenteredTextInputLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:background="#DFE7EE" />
                    <TextView
                        style="@style/PortalEyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_priority_step"
                        android:textColor="#087F8C"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/forms_priority_caption"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <RadioGroup
                        android:id="@+id/priorityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/normalPriority"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:background="@drawable/form_priority_surface"
                            android:padding="12dp"
                            android:text="@string/forms_normal"
                            android:textColor="#142D40"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:textAlignment="center" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/urgentPriority"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:minHeight="56dp"
                            android:background="@drawable/form_priority_surface"
                            android:padding="12dp"
                            android:text="@string/forms_urgent"
                            android:textColor="#142D40"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:textAlignment="center" />
                    </RadioGroup>
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/confirmationCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/forms_confirmation"
                        android:textColor="#627789"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submitButton"
                        style="@style/PortalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/forms_submit"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/PortalEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/forms_record_eyebrow"
                android:gravity="center"
                android:textAlignment="center" />
            <com.google.android.material.card.MaterialCardView
                style="@style/PortalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E5F3F1"
                app:strokeColor="#C9E5DF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/forms_latest"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#112D43"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        style="@style/PortalSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/forms_record_caption"
                        android:textColor="#147D64"
                        android:gravity="center"
                        android:textAlignment="center" />
                    <TextView
                        android:id="@+id/latestRequest"
                        style="@style/PortalBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="7dp"
                        android:text="@string/forms_no_request"
                        android:textIsSelectable="true"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
