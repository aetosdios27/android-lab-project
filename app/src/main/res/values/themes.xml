<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseTheme.MujStudentPortal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="materialAlertDialogTheme">@style/PortalDialog</item>
        <item name="textInputStyle">@style/PortalField</item>
        <item name="materialButtonStyle">@style/PortalButton</item>
    </style>
    <style name="Theme.MujStudentPortal" parent="BaseTheme.MujStudentPortal" />
    <style name="PortalTitle">
        <item name="android:textSize">25sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="PortalDisplay" parent="PortalTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="PortalSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="PortalBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="PortalEyebrow">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="PortalPill">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/bg_pill_teal</item>
    </style>
    <style name="PortalCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">0.8dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="rippleColor">#17087F8C</item>
    </style>
    <style name="PortalButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="PortalField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/muted</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="errorIconDrawable">@null</item>
        <item name="expandedHintEnabled">false</item>
    </style>
    <style name="PortalToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="android:minHeight">56dp</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="navigationIconTint">@color/navy</item>
        <item name="titleTextAppearance">@style/PortalToolbarTitle</item>
        <item name="contentInsetStartWithNavigation">8dp</item>
        <item name="titleCentered">true</item>
    </style>
    <style name="PortalToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="PortalDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/PortalDialogShape</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PortalDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/PortalDialogBody</item>
    </style>
    <style name="PortalDialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="PortalDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="PortalDialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>
</resources>
