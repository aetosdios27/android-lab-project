<?xml version="1.0" ?>
<resources>
    <style name="BaseTheme.MujStudentPortal" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSecondaryContainer">@color/primary_surface</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/secondary_ink</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="materialButtonStyle">@style/PortalButton</item>
        <item name="textInputStyle">@style/PortalField</item>
    </style>
    <style name="PortalButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="PortalField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="errorIconDrawable">@null</item>
    </style>
    <style name="PortalHeading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PortalBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/secondary_ink</item>
    </style>
    <style name="PortalToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/secondary_ink</item>
    </style>
    <style name="Theme.MujStudentPortal" parent="BaseTheme.MujStudentPortal"/>
</resources>
